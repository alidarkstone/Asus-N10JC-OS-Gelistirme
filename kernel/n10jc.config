# N10 OS kernel fragment for the Asus N10JC (Atom N270, 1 GB, GMA 950 + 9300M GS)
# Merged on top of Debian bookworm's 686-pae config, then `make olddefconfig`.
# kernel/check-config.sh verifies the values that matter after the merge.

# --- CPU ---
CONFIG_M686=n
CONFIG_MATOM=y
CONFIG_X86_PAE=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_SCHED_SMT=y
CONFIG_X86_INTEL_LPSS=n
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_X86_P4_CLOCKMOD=n
CONFIG_INTEL_IDLE=y

# --- Memory: map the whole 1 GB as lowmem ---
CONFIG_EXPERT=y
# (6.18: HIGHMEM4G off => no highmem; VMSPLIT_2G keeps PAE/NX and maps ~1.8 GB as lowmem)
CONFIG_HIGHMEM4G=n
CONFIG_VMSPLIT_2G=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZSWAP=n
CONFIG_PSI=y

# --- Latency ---
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_HZ_300=y
CONFIG_HZ_250=n
CONFIG_NO_HZ_IDLE=y

# --- Storage / filesystems (built in) ---
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=m
CONFIG_SQUASHFS=y
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_MQ_IOSCHED_DEADLINE=y

# --- Graphics ---
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_FBDEV_EMULATION=y

# --- Laptop platform ---
CONFIG_ASUS_LAPTOP=m
CONFIG_EEEPC_LAPTOP=n
CONFIG_ACPI_VIDEO=y
CONFIG_SENSORS_CORETEMP=m

# --- Net / audio / misc (modules, auto-loaded) ---
CONFIG_ATH9K=m
CONFIG_R8169=m
CONFIG_SND_HDA_INTEL=m
CONFIG_USB_VIDEO_CLASS=m
CONFIG_BT_HCIBTUSB=m

# --- Trim debug overhead ---
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_BTF=n
CONFIG_MODULE_SIG=n
CONFIG_DEBUG_KERNEL=n
CONFIG_SLUB_DEBUG=n
CONFIG_FTRACE=n
CONFIG_KPROBES=n
CONFIG_LOCALVERSION="-n10jc"
