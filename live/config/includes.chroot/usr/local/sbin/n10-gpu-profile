#!/bin/sh
# Detect which GPU the BIOS exposed (N10JC has a physical switch + reboot)
# and apply the matching profile. Writes the mode to /run/n10-gpu-mode.
set -u
mode=intel
if grep -qs '^0x10de$' /sys/bus/pci/devices/*/vendor; then
  for d in /sys/bus/pci/devices/*; do
    [ "$(cat "$d/vendor")" = 0x10de ] && [ "$(cut -c1-6 "$d/class")" = 0x0300 ] && mode=nvidia
  done
fi
echo "$mode" > /run/n10-gpu-mode

# Xorg driver per mode (this runs before the desktop starts):
#  intel : GMA 950 with the intel DDX and SNA, the fastest 2D path for this
#          old chip (glamor needs more GL than the GMA 950 really has)
#  nvidia: GeForce 9300M GS with nouveau + modesetting/glamor (OpenGL 3.3 via Mesa)
mkdir -p /etc/X11/xorg.conf.d
if [ "$mode" = nvidia ]; then
  cat > /etc/X11/xorg.conf.d/20-n10jc-gpu.conf <<'XORG'
Section "Device"
    Identifier "GPU"
    Driver     "modesetting"
    Option     "AccelMethod" "glamor"
EndSection
XORG
elif grep -qs '^0x8086$' /sys/class/drm/card0/device/vendor; then
  cat > /etc/X11/xorg.conf.d/20-n10jc-gpu.conf <<'XORG'
Section "Device"
    Identifier "GPU"
    Driver     "intel"
    Option     "AccelMethod" "sna"
    Option     "TearFree" "true"
EndSection
XORG
else
  rm -f /etc/X11/xorg.conf.d/20-n10jc-gpu.conf   # other GPU (e.g. a VM): let Xorg pick
fi

# mpv (YouTube via n10-youtube): H.264 only (VP9/AV1 are far too heavy for the
# Atom), cheap decoder shortcuts, and the fastest video output for each GPU.
mkdir -p /etc/mpv
cat > /etc/mpv/mpv.conf <<'MPV'
ytdl-format=bestvideo[height<=?480][vcodec^=avc1]+bestaudio[acodec^=mp4a]/best[height<=?480][vcodec^=avc1]/best[height<=?480]
cache=yes
demuxer-max-bytes=48MiB
framedrop=vo
vd-lavc-fast=yes
vd-lavc-skiploopfilter=nonkey
vd-lavc-threads=2
keep-open=yes
osd-font="Inter"
MPV
if [ "$mode" = nvidia ]; then
  printf 'vo=gpu,xv,\ngpu-api=opengl\nhwdec=vdpau\n' >> /etc/mpv/mpv.conf
else
  printf 'vo=xv,gpu,\nhwdec=no\n' >> /etc/mpv/mpv.conf
fi

# Ambient light sensor makes brightness jump around: turn it off.
for f in /sys/devices/platform/asus_laptop/ls_switch; do [ -w "$f" ] && echo 0 > "$f"; done

if [ "$mode" = nvidia ]; then
  # 3D / video profile: nouveau, VDPAU if firmware is present.
  modprobe nouveau 2>/dev/null || true
  [ -e /lib/firmware/nouveau/.n10-ok ] || logger -t n10 "No VP3 firmware: run n10-nouveau-firmware for H.264 hardware decode"
  echo performance > /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null || true
else
  # Battery profile on the GMA 950.
  echo schedutil > /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null || true
  for h in /sys/class/scsi_host/host*/link_power_management_policy; do
    [ -w "$h" ] && echo med_power_with_dipm > "$h"
  done
  echo 1 > /sys/module/snd_hda_intel/parameters/power_save 2>/dev/null || true
fi
logger -t n10 "GPU mode: $mode"
