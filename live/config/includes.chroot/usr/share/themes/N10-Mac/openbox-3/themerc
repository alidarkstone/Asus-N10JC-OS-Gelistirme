# N10-Mac: light, flat Openbox theme with macOS-style traffic-light buttons.
# Buttons are left (titleLayout CIML in rc.xml); per-button colours need Openbox >= 3.6.
border.width: 1
padding.width: 8
padding.height: 4
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0

window.active.border.color: #c8c8cc
window.inactive.border.color: #d8d8dc
window.active.title.bg: flat solid
window.active.title.bg.color: #ececee
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #f6f6f6
window.active.label.bg: parentrelative
window.inactive.label.bg: parentrelative
window.active.label.text.color: #2b2b2e
window.inactive.label.text.color: #a0a0a5
window.label.text.justify: center

window.active.button.unpressed.bg: parentrelative
window.active.button.pressed.bg: parentrelative
window.active.button.hover.bg: parentrelative
window.active.button.disabled.bg: parentrelative
window.active.button.toggled.unpressed.bg: parentrelative
window.active.button.toggled.pressed.bg: parentrelative
window.active.button.toggled.hover.bg: parentrelative
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.pressed.bg: parentrelative
window.inactive.button.hover.bg: parentrelative
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.toggled.unpressed.bg: parentrelative
window.inactive.button.toggled.pressed.bg: parentrelative
window.inactive.button.toggled.hover.bg: parentrelative

window.active.button.unpressed.image.color: #8e8e93
window.inactive.button.unpressed.image.color: #d1d1d6
window.active.button.close.unpressed.image.color: #ff5f57
window.active.button.close.hover.image.color: #e0443e
window.active.button.close.pressed.image.color: #bf3a34
window.active.button.iconify.unpressed.image.color: #febc2e
window.active.button.iconify.hover.image.color: #dea123
window.active.button.iconify.pressed.image.color: #bd891d
window.active.button.max.unpressed.image.color: #28c840
window.active.button.max.hover.image.color: #1aab29
window.active.button.max.pressed.image.color: #159122
window.active.button.max.toggled.unpressed.image.color: #28c840
window.active.button.max.toggled.hover.image.color: #1aab29
window.inactive.button.close.unpressed.image.color: #d1d1d6
window.inactive.button.iconify.unpressed.image.color: #d1d1d6
window.inactive.button.max.unpressed.image.color: #d1d1d6

menu.border.width: 1
menu.border.color: #d0d0d4
menu.separator.color: #e0e0e4
menu.title.bg: flat solid
menu.title.bg.color: #f5f5f7
menu.title.text.color: #6e6e73
menu.items.bg: flat solid
menu.items.bg.color: #f5f5f7
menu.items.text.color: #1d1d1f
menu.items.disabled.text.color: #b0b0b5
menu.items.active.bg: flat solid
menu.items.active.bg.color: #0a84ff
menu.items.active.text.color: #ffffff
menu.overlap: 0

osd.border.width: 1
osd.border.color: #d0d0d4
osd.bg: flat solid
osd.bg.color: #f5f5f7
osd.label.text.color: #1d1d1f
osd.hilight.bg: flat solid
osd.hilight.bg.color: #0a84ff
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #d1d1d6

# Roomier, rounded-feeling menu items
menu.items.padding.width: 10
menu.items.padding.height: 5
menu.title.text.justify: left
