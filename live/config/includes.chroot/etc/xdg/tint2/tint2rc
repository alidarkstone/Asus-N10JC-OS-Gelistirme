# N10 OS top bar: macOS-style menu bar (light, translucent, no taskbar; the dock does that)
# Background 1: bar
rounded = 0
border_width = 0
background_color = #f5f5f7 78
border_color = #000000 0
background_color_hover = #f5f5f7 78
border_color_hover = #000000 0
background_color_pressed = #f5f5f7 78
border_color_pressed = #000000 0
# Background 2: hover pill
rounded = 5
border_width = 0
background_color = #000000 0
border_color = #000000 0
background_color_hover = #000000 12
border_color_hover = #000000 0
background_color_pressed = #000000 20
border_color_pressed = #000000 0

# P = start button (ROG eye), F = free space, E = GPU status, S = tray, C = clock
panel_items = PFESC
panel_size = 100% 28
panel_margin = 0 0
panel_padding = 8 0 8
panel_background_id = 1
panel_position = top center horizontal
panel_layer = top
panel_monitor = all
panel_shrink = 0
wm_menu = 1
panel_dock = 0
strut_policy = follow_size
autohide = 0
font_shadow = 0
mouse_effects = 1

button = new
button_icon = /usr/share/n10os/rog-eye.png
button_text = ROG
button_font = Inter Black 11
button_font_color = #e4002b 100
button_max_icon_size = 24
button_padding = 8 2 6
button_background_id = 2
button_centered = 1
button_lclick_command = n10-menu drun
button_rclick_command = n10-menu drun
button_tooltip = Uygulamalar (Alt+Boşluk)

systray_padding = 6 0 10
systray_background_id = 0
systray_sort = right2left
systray_icon_size = 16
# Tray icons darkened (WhiteSur panel icons are white) so they read on the light bar
systray_icon_asb = 100 0 -85
systray_monitor = 1

time1_format = %a %-d %b  %H:%M
time1_font = Inter Medium 10
clock_font_color = #1d1d1f 100
clock_padding = 6 0
clock_background_id = 2
clock_tooltip = %A %d %B %Y

# Active GPU and whether OpenGL is hardware accelerated (click: details)
execp = new
execp_command = n10-gpu-durum
execp_interval = 0
execp_continuous = 0
execp_has_icon = 0
execp_font = Inter Medium 9
execp_font_color = #1d1d1f 100
execp_padding = 6 0
execp_background_id = 2
execp_lclick_command = n10-gpu-durum --detay
