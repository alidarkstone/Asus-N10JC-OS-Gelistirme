/* N10 OS: Spotlight-style launcher (Alt+Space) */
configuration {
  modi: "drun,run";
  show-icons: true;
  icon-theme: "WhiteSur";
  font: "Inter 11";
  drun-display-format: "{name}";
  display-drun: "";
  display-run: "";
}
* {
  bg: #f5f5f7f0;
  fg: #1d1d1f;
  muted: #6e6e73;
  sel: #0a84ff;
  background-color: transparent;
  text-color: @fg;
}
window {
  width: 560px;
  location: north;
  anchor: north;
  y-offset: 110px;
  border: 1px;
  border-color: #00000020;
  border-radius: 12px;
  background-color: @bg;
  padding: 12px;
}
mainbox { spacing: 8px; }
inputbar {
  children: [ entry ];
  padding: 9px 12px;
  background-color: #ffffff;
  border-radius: 8px;
}
entry { placeholder: "Uygulama ara"; placeholder-color: @muted; font: "Inter 14"; }
listview { lines: 7; scrollbar: false; spacing: 2px; }
element, element normal.normal, element alternate.normal { background-color: transparent; text-color: @fg; }
element { padding: 6px 10px; border-radius: 6px; spacing: 10px; }
element selected { background-color: @sel; text-color: #ffffff; }
element-icon { size: 22px; }
element-text { text-color: inherit; vertical-align: 0.5; }
