/* N10 OS app menu: macOS Launchpad-style grid with Spotlight search on top.
   Opened by the ROG button and Alt+Space (n10-menu). Type to search. */
configuration {
  modi: "drun";
  show-icons: true;
  icon-theme: "WhiteSur";
  font: "Inter 10";
  drun-display-format: "{name}";
  display-drun: "";
  drun-match-fields: "name,generic,keywords,categories";
  sort: true;
  sorting-method: "fzf";
  matching: "fuzzy";
  hover-select: true;
  me-select-entry: "";
  me-accept-entry: "MousePrimary";
  click-to-exit: true;
  disable-history: false;
  scroll-method: 0;
}
* {
  bg:      #f6f6f8f4;
  card:    #ffffff;
  fg:      #1d1d1f;
  muted:   #86868b;
  accent:  #0a84ff;
  hover:   #dbe8fc;
  background-color: transparent;
  text-color: @fg;
  font: "Inter 10";
}
window {
  location: center;
  anchor: center;
  width: 720px;
  border: 1px solid;
  border-color: #0000001a;
  border-radius: 18px;
  background-color: @bg;
  padding: 22px 22px 16px 22px;
}
mainbox { border: 0; spacing: 18px; children: [ inputbar, listview ]; }
inputbar {
  children: [ icon-search, entry ];
  border: 0;
  spacing: 8px;
  padding: 9px 14px;
  margin: 0 150px;
  border-radius: 10px;
  background-color: #7676801f;
}
icon-search { expand: false; filename: "system-search-symbolic"; size: 16px; vertical-align: 0.5; }
entry {
  placeholder: "Ara";
  placeholder-color: @muted;
  font: "Inter 12";
  vertical-align: 0.5;
  cursor: text;
}
listview {
  border: 0;
  columns: 5;
  lines: 3;
  fixed-height: true;
  fixed-columns: true;
  spacing: 6px;
  scrollbar: false;
  cycle: false;
  layout: vertical;
  flow: horizontal;
}
element {
  orientation: vertical;
  padding: 12px 6px 10px 6px;
  spacing: 8px;
  border-radius: 12px;
  cursor: pointer;
}
element normal.normal, element alternate.normal, element normal.active, element alternate.active {
  background-color: transparent; text-color: @fg;
}
element selected.normal, element selected.active {
  background-color: @hover; text-color: @fg;
}
element-icon { size: 48px; horizontal-align: 0.5; cursor: inherit; }
element-text {
  horizontal-align: 0.5;
  vertical-align: 0.5;
  font: "Inter Medium 9";
  text-color: inherit;
  cursor: inherit;
}
