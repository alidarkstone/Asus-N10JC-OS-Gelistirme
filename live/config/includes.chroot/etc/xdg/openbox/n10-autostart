# N10 OS session programs, started by /usr/local/bin/n10-session after openbox is up.
feh --no-fehbg --bg-fill /usr/share/backgrounds/n10os/default.jpg &
tint2 &
(sleep 2; plank) &
nm-applet &
blueman-applet &
volumeicon &
xfce4-power-manager &
dunst &
# Light compositor (xrender, GMA 950 friendly): soft shadows, rounded corners and
# short fades (no --vsync: picom has no vsync method for xrender and exits)
# short fades so menus and windows open smoothly without costing much CPU
picom --backend xrender --fading --fade-in-step 0.14 --fade-out-step 0.18 --fade-delta 8 --shadow --shadow-radius 14 --shadow-opacity 0.25 --corner-radius 8 --shadow-exclude "class_g = 'Plank'" --shadow-exclude "class_g = 'Tint2'" -b &
