# N10 OS session programs, started by /usr/local/bin/n10-session after openbox is up.
feh --no-fehbg --bg-fill /usr/share/backgrounds/n10os/default.jpg &
tint2 &
(sleep 2; plank) &
nm-applet &
dunst &
# Startup chime (also an instant check that sound works)
(sleep 1; pw-play /usr/share/sounds/n10os/acilis.wav 2>/dev/null || aplay -q /usr/share/sounds/n10os/acilis.wav) &
# Compositor with every effect off (no fades, shadows, blur or animation). It is
# only there so the dock and the rounded menu corners draw cleanly.
picom --backend xrender --no-fading-openclose --unredir-if-possible -b &
