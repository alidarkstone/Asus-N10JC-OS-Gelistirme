# N10 OS session (system-wide; appended to /etc/xdg/openbox/autostart by hook 0300)
xsetroot -solid '#1d1f24' &
[ -f "$HOME/.fehbg" ] && sh "$HOME/.fehbg" &
tint2 &
plank &
nm-applet &
volumeicon &
xfce4-power-manager &
dunst &
# Light compositor: shadows only, xrender backend (GMA 950 friendly)
picom --backend xrender --vsync --no-fading-openclose --shadow -b &
