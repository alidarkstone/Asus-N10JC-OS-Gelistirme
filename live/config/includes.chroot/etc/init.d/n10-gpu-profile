#!/bin/sh
### BEGIN INIT INFO
# Provides:          n10-gpu-profile
# Required-Start:    $local_fs udev
# Required-Stop:
# Default-Start:     S
# Default-Stop:
# Short-Description: Apply N10JC GPU-switch power/graphics profile
### END INIT INFO
case "$1" in
  start) /usr/local/sbin/n10-gpu-profile ;;
  stop|restart|force-reload) ;;
  *) echo "Usage: $0 start"; exit 1 ;;
esac
