#!/bin/sh
set -e
for u in n10-gpu-profile.service n10-radio-on.service n10-audio-on.service zramswap.service earlyoom.service fstrim.timer n10-rapor.timer; do
  systemctl enable "$u" || echo "WARN: could not enable $u"
done
# console-setup only sets the text-console font and keymap. It fails here and
# adds a red [FAILED] line to the boot, so mask it (the keymap is set by X).
systemctl mask console-setup.service || true
# blueman's root helper took 15 s at boot on the N10JC: start it only when the
# Bluetooth manager asks for it (D-Bus activation still works)
systemctl disable blueman-mechanism.service 2>/dev/null || true
# Logs: volatile journal (journald.conf.d); keep rotated text logs compressed
sed -i 's/^#\?\s*compress/compress/' /etc/logrotate.conf 2>/dev/null || true
# /tmp in RAM, capped
grep -q ' /tmp ' /etc/fstab 2>/dev/null || echo 'tmpfs /tmp tmpfs defaults,noatime,nosuid,size=128M 0 0' >> /etc/fstab
