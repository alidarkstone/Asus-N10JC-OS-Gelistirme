#!/bin/sh
set -e
for u in n10-gpu-profile.service n10-radio-on.service n10-audio-on.service zramswap.service earlyoom.service fstrim.timer; do
  systemctl enable "$u" || echo "WARN: could not enable $u"
done
# Logs: volatile journal (journald.conf.d); keep rotated text logs compressed
sed -i 's/^#\?\s*compress/compress/' /etc/logrotate.conf 2>/dev/null || true
# /tmp in RAM, capped
grep -q ' /tmp ' /etc/fstab 2>/dev/null || echo 'tmpfs /tmp tmpfs defaults,noatime,nosuid,size=128M 0 0' >> /etc/fstab
