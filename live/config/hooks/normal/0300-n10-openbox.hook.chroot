#!/bin/sh
# Openbox: macOS-like window buttons on the left, N10-Mac theme, Inter font, keybindings.
# Applied to the system rc.xml (fallback) and to the skel copy users get.
set -e
rc=/etc/xdg/openbox/rc.xml
sed -i 's#<keyboard>#<keyboard>\
    <keybind key="A-space"><action name="Execute"><command>rofi -show drun</command></action></keybind>\
    <keybind key="W-space"><action name="Execute"><command>rofi -show drun</command></action></keybind>\
    <keybind key="W-Return"><action name="Execute"><command>lxterminal</command></action></keybind>\
    <keybind key="W-b"><action name="Execute"><command>chromium</command></action></keybind>\
    <keybind key="W-e"><action name="Execute"><command>pcmanfm</command></action></keybind>\
    <keybind key="W-q"><action name="Close"/></keybind>#' "$rc"
sed -i '/<theme>/,/<\/theme>/ s#<name>[^<]*</name>#<name>N10-Mac</name>#' "$rc"
sed -i 's#<titleLayout>[^<]*</titleLayout>#<titleLayout>CIML</titleLayout>#' "$rc"
sed -i '/<font place=/,/<\/font>/ s#<name>[^<]*</name>#<name>Inter</name>#' "$rc"
grep -n "N10-Mac\|CIML\|A-space" "$rc"
mkdir -p /etc/skel/.config/openbox
cp "$rc" /etc/skel/.config/openbox/rc.xml

# Session start must not depend on files in the user's home: startx without
# ~/.xinitrc runs Xsession -> x-session-manager, so point that at openbox-session
# and put our autostart in the system-wide openbox autostart.
update-alternatives --set x-session-manager /usr/bin/openbox-session \
  || update-alternatives --install /usr/bin/x-session-manager x-session-manager /usr/bin/openbox-session 90
cat /etc/xdg/openbox/n10-autostart >> /etc/xdg/openbox/autostart

# Snappier menus: submenus open instantly, menus close quickly
for f in /etc/xdg/openbox/rc.xml /etc/skel/.config/openbox/rc.xml; do
  sed -i 's#<hideDelay>[0-9]*</hideDelay>#<hideDelay>120</hideDelay>#; s#<submenuShowDelay>[0-9]*</submenuShowDelay>#<submenuShowDelay>0</submenuShowDelay>#; s#<submenuHideDelay>[0-9]*</submenuHideDelay>#<submenuHideDelay>200</submenuHideDelay>#' "$f"
done
