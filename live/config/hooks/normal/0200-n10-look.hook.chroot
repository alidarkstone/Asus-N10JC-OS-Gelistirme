#!/bin/sh
# macOS look on a budget: WhiteSur GTK + icons + cursors, plank theme, Inter font.
# Build tools are installed only for this hook and removed afterwards.
set -e
# ca-certificates stays installed: later hooks and the live system need HTTPS
TOOLS="git sassc libglib2.0-dev-bin libxml2-utils"
apt-get install -y --no-install-recommends ca-certificates $TOOLS
tmp=$(mktemp -d)

if git clone --depth 1 https://github.com/vinceliuice/WhiteSur-gtk-theme "$tmp/gtk"; then
  # install.sh looks up the invoking user via logname, which has no answer in a chroot.
  # No -l (libadwaita/GTK4): it refuses to run as root and N10 OS has no GTK4 apps.
  # The installer hides its own stderr in a log it deletes on exit: keep stderr visible
  sed -i 's|exec 2> "${WHITESUR_TMP_DIR}/error_log.txt"|:|' "$tmp/gtk/libs/lib-core.sh"
  (cd "$tmp/gtk" && SUDO_USER=root USER=root HOME=/root bash -x ./install.sh -d /usr/share/themes -c light -o normal >"$tmp/gtk.log" 2>&1) \
    || { tail -80 "$tmp/gtk.log"; echo "WARN: WhiteSur GTK install failed"; }
  # It also installs a GNOME/GTK4 theme switcher that is useless here
  rm -f /usr/bin/gnome-theme-switcher /usr/share/applications/org.gnome.GTK4ThemeSwitcher.desktop
  # Plank dock theme shipped in the same repo
  for p in "$tmp/gtk/src/other/plank/theme-Light" "$tmp/gtk/src/other/plank/theme-light"; do
    [ -d "$p" ] && mkdir -p /usr/share/plank/themes && cp -r "$p" /usr/share/plank/themes/WhiteSur-Light && break
  done
fi
git clone --depth 1 https://github.com/vinceliuice/WhiteSur-icon-theme "$tmp/icons" \
  && (cd "$tmp/icons" && ./install.sh -d /usr/share/icons) \
  || echo "WARN: WhiteSur icons not installed (Papirus stays as fallback)"
git clone --depth 1 https://github.com/vinceliuice/WhiteSur-cursors "$tmp/cursors" \
  && cp -r "$tmp/cursors/dist" /usr/share/icons/WhiteSur-cursors \
  || echo "WARN: WhiteSur cursors not installed"

rm -rf "$tmp"
apt-get purge -y $TOOLS || true
apt-get autoremove -y
ls /usr/share/themes /usr/share/icons /usr/share/plank/themes 2>/dev/null || true

# GTK2 apps follow the same theme
mkdir -p /etc/gtk-2.0
cat > /etc/gtk-2.0/gtkrc <<EOT
gtk-theme-name="WhiteSur-Light"
gtk-icon-theme-name="WhiteSur"
gtk-cursor-theme-name="WhiteSur-cursors"
gtk-font-name="Inter 10"
EOT
# Plank defaults (theme, size, items) via the system dconf database
dconf update
# Fontconfig: grayscale AA + slight hinting looks closest to macOS on a 1024x600 panel
mkdir -p /etc/fonts/conf.d
cat > /etc/fonts/local.conf <<EOT
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <match target="font">
    <edit name="antialias" mode="assign"><bool>true</bool></edit>
    <edit name="hinting" mode="assign"><bool>true</bool></edit>
    <edit name="hintstyle" mode="assign"><const>hintslight</const></edit>
    <edit name="rgba" mode="assign"><const>none</const></edit>
  </match>
  <alias><family>sans-serif</family><prefer><family>Inter</family></prefer></alias>
</fontconfig>
EOT
